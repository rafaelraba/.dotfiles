{
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "engram@engram": true,
    "figma@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "repo": "Gentleman-Programming/engram",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\"; fi",
            "type": "command"
          },
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\"; fi",
            "type": "command"
          },
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\"; fi",
            "type": "command"
          },
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\"; fi",
            "type": "command"
          },
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/rafaba/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\"; fi",
            "type": "command"
          },
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/Library/Application Support/orca/agent-hooks/claude-hook.sh\"; fi",
            "type": "command"
          },
          {
            "command": "$HOME/.dotfiles/scripts/claude-agent-status.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "spanish",
  "outputStyle": "Gentleman",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf ~)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "$HOME/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}