#############################################################
# ℹ️ Reminder: You can reload the config with `cmd+shift+,`  #
# `ghostty +show-config --default --docs`                   #
#############################################################

shell-integration = zsh

# 🪟 Window

macos-titlebar-style = hidden
background-opacity = 1.0
background-blur-radius = 0
window-save-state = always
window-height = 14
window-width = 180
window-padding-balance = true
window-colorspace = display-p3
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true
window-step-resize = true
unfocused-split-opacity = 1.0
macos-option-as-alt = left

# 📝 Font

font-size = 15
font-thicken = true
adjust-cell-height = 30%
font-family = JetBrainsMono Nerd Font Mono

# 📋 Clipboard

clipboard-read = allow
clipboard-write = allow
copy-on-select = false

# 📍 Cursor

cursor-color = #eaeaea
cursor-style = bar
adjust-cursor-thickness = 50%
cursor-color = #5cf19e

# 🥖 Quick Terminal

keybind = global:cmd+opt+grave_accent=toggle_quick_terminal
quick-terminal-position = bottom
quick-terminal-animation-duration = 0.06
quick-terminal-autohide = true

# ⌨️ Keybindings
# List all with: `ghostty +list-keybinds`
# Useful ones:
# - `cmd+shift+,`: to reload the config
# - `cmd+up`: `jump_to_prompt:-1`
# - `cmd+down`: `jump_to_prompt:1`

# Block accidental tabs that re-trigger tmux auto-start.
keybind = cmd+t=ignore

# Tmux session navigation: Option + arrows
keybind = alt+arrow_left=text:\x01H
keybind = alt+arrow_right=text:\x01L

# Tmux bottom runner panel: Option + Enter
keybind = alt+enter=text:\x01\r

# Spanish characters in Ghostty without global automation tools.
keybind = ctrl+alt+n=text:ñ
keybind = ctrl+alt+shift+n=text:Ñ
keybind = ctrl+alt+e=text:´

# 🎨 Theme

theme = Kanagawa Dragon


bold-is-bright = true


keybind = shift+enter=text:\x1b\r
